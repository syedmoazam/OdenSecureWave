<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- Legacy Device Admin Policies -->
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <wipe-data />
        <expire-password />
        <encrypted-storage />
        <disable-camera />
        <disable-keyguard-features />
        
        <!-- Android 12+ Device Owner Policies -->
        <uses-policy android:name="android.app.policy.DEVICE_OWNER" />
        <uses-policy android:name="android.app.policy.MANAGED_PROFILE_OWNER" />
    </uses-policies>
</device-admin>
